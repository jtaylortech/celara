# ChainETL Configuration Example
# Copy this file to .env and update with your values

# Database Configuration
DATABASE_URL=postgresql://localhost/chainetl_dev

# Ethereum RPC URL
# You can use public RPCs or your own node
ETHEREUM_RPC_URL=https://eth.llamarpc.com
# Alternative Ethereum RPCs:
# ETHEREUM_RPC_URL=https://rpc.ankr.com/eth
# ETHEREUM_RPC_URL=https://ethereum.publicnode.com

# Base L2 RPC URL
BASE_RPC_URL=https://mainnet.base.org
# Alternative Base RPCs:
# BASE_RPC_URL=https://base.llamarpc.com
# BASE_RPC_URL=https://base.publicnode.com

# Logging Configuration (optional)
# LOG_LEVEL=INFO
# LOG_FORMAT=json
